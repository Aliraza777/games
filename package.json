{
  "name": "personal-games",
  "private": true,
  "description": "A home for small browser games. Each game in games/<name> is a self-contained Vite app with its own dependencies and deploy target.",
  "type": "module",
  "scripts": {
    "games": "node scripts/games.mjs list",
    "new-game": "node scripts/games.mjs new",
    "dev": "node scripts/games.mjs run dev",
    "build": "node scripts/games.mjs run build",
    "test": "node scripts/games.mjs run test",
    "install:all": "node scripts/games.mjs install --all",
    "build:all": "node scripts/games.mjs run build --all",
    "test:all": "node scripts/games.mjs run test --all"
  },
  "engines": {
    "node": ">=20"
  }
}
